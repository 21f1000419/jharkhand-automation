<script language="javascript" type="text/javascript"> 



var saltVal = "0593734c47891c352e632db8a06157d7";	
	
	function submitLoginForm(first_call)
	{

		if(checkEmptyFields())
		{
	
	    var userUniqueId = document.loginForm.userId.value;
	
	    var pwd = document.loginForm.userPwd.value;
	    
	    if ( first_call &&  !g_key )

   		 {

		  var salt = hexToByteArray(saltVal);
	      deriveKey(userUniqueId, salt); // Derive key
		  setTimeout("submitLoginForm(false)",100);
		  return;
   	    }
   		
   	    if (!first_call && !g_key)
   	    {
   	    	
   		   setTimeout("submitLoginForm(false)",100); // Wait for key
   		   return;
   	    }
	
    
    

	  
	  
	    var enc_pwd = byteArrayToHex(aesEncrypt(pwd, g_key)); // AES Encryption
	  
	    document.loginForm.refreshTab.value = saltVal;
	    document.loginForm.userPwd.value = enc_pwd;
		//document.loginForm.action = "/eStampIndia/useradmin/UserAdminLoginServlet?rDoAction=ValidateLogin"
		// Use the server-built, URL-encoded action (may contain ;jsessionid)
        document.loginForm.action = document.getElementById('loginActionUrl').value;
	    document.loginForm.submit();

		}
	 
		
	}
	
	

</script>
<!--  CR09_10042015_Password Reset - Added for captcha implementation in Login page -->
<script language="javascript" type="text/javascript">

	function reloadImg(id) {
 
		if(id == 'cap')
		{
		   var obj1 = document.getElementById(id);
		
		   var obj2 = document.getElementById('cap');
	
		}
		if(id == 'cap1')
				{
					var obj1 = document.getElementById('cap');
				   var obj2 = document.getElementById(id);
				}	
				
		 var src1 = obj1.src;
		
		 var src2 = obj2.src;
		 var pos1 = src1.indexOf('?');
		 var pos2 = src2.indexOf('?');
		   
		   if (pos1 >= 0) {
		      src1 = src1.substr(0, pos1);
		   }
		   if (pos2 >= 0) {
			      src2 = src2.substr(0, pos2);
			   }
			
		   var date = new Date();
		   obj1.src = src1 + '?v=' + date.getTime()+'&action=ajax';
		   obj2.src = src2 + '?v=' + date.getTime()+'&action=ajax';
			
		   return false;
		} 
	
<!-- CR09_10042015_Password Reset - end -->	

function refreshCaptcha() {
    var img = document.getElementById('cap');
    var base = img.getAttribute('data-base'); // this is the encoded base URL from the server
    var sep = (base.indexOf('?') >= 0) ? '&' : '?';
    img.src = base + sep + "action=refresh&_ts=" + Date.now();
    return false;
}
	</script>

<script language="javascript" type="text/javascript">

function checkEmptyFields()
{
	
	if(checkEmpty(document.loginForm.userId))
	{
		alert("Please enter a valid User ID!");
		return false;
	}
	if(checkEmpty(document.loginForm.userPwd))
	{
		alert("Please enter a valid password!");
		return false;
	}
	<!-- CR09_10042015_Password Reset , added if confition / Deepthi - changed Message-->
	// Commented for enable and disable feature of Captcha
	/* if(checkEmpty(document.loginForm.searchjcaptcha))
	{
		alert("Enter the text as displayed in captcha");
		return false;
	} */
	return true;
}
/*
Added enterSubmit(event)Modiified by Avinash for Firefox 
*/
function enterSubmit(e) {
  if ((window.event && window.event.keyCode == 13)|| e.which == 13)
  {
	
    submitLoginForm(true);

  }
  else
  {
	 
    return true;
  }
}

var termsWindow_width="500", termsWindow_height="300";
var termsWindow_left =(screen.width/2) - termsWindow_width/2;
var termsWindow_top = (screen.height/2) - termsWindow_height/2;
var styleStr_termsWindow ='toolbar=no,location=no,directories=no,status=no,menubar=no,scrollbars=yes,resizable=yes,copyhistory=yes,width='+termsWindow_width+',height='+termsWindow_height+',left='+termsWindow_left+',top='+termsWindow_top+',screenX='+termsWindow_left+',screenY='+termsWindow_top;
var termsWindowHandler = null;
function openPopUpTerms(url)
{
   if(termsWindowHandler != null)
   {
	   termsWindowHandler.close();
   }
   termsWindowHandler = window.open(url,"termsWindow", styleStr_termsWindow);     
   if (!termsWindowHandler.opener)
   {
		termsWindowHandler.opener = self;
   }
}

function setWindowName(){
	window.name = "eStamp";
	document.getElementById("windowName").value = "eStamp";
}

</script>


